{
  "name": "magpie-autoswitch",
  "version": "0.7.0",
  "description": "AutoSwitch for Magpie: one model that automatically fails over across free and (optionally) paid models of every enabled provider, with cooldown memory, a paid-policy switch, and a local web console",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "src",
    "icon.png",
    "README.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "provider",
    "model-switch",
    "failover",
    "free-model",
    "rate-limit",
    "routing"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/png;base64,",
    "maxConcurrency": 4
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack": "node scripts/pack.mjs",
    "report:upstream": "node scripts/upstream-report.mjs"
  }
}
