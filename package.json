{
  "name": "magpie-free-switch",
  "version": "0.1.0",
  "description": "Free Switch for Magpie: one model that automatically fails over across the free models of every enabled provider, remembers each model's rate-limit wake-up, and traces every switch in a local web console",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "src",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "provider",
    "free-model",
    "failover",
    "rate-limit",
    "routing"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 4
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack": "node scripts/pack.mjs"
  }
}
